OSR=`uname -r`

if (/usr/bin/test -f $1.cc)
then

  tmp="-f makefile.linux f=$1 R=$OSR"
  if (/usr/bin/test -f $1.mf.linux)
  then
    tmp="-f $1.mf.linux R=$OSR $1"
  fi

  if (make $tmp 2> $1.log)

  then
    cat $1.log
    chmod -w $1.cc
    exit
  fi

  cat $1.log
  exit
fi
echo $1.cc does not exist

